{
  "info": {
    "_postman_id": "87c1b95c-f57d-4a80-94e1-06ea45a3315e",
    "name": "OAuth 2.0 Mini Platform",
    "description": "End-to-end checks for the exercise-specific JWT issuer and secured Resource Server. Run the requests in folder order with both local applications running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Core flow",
      "description": "Issues a JWT access token, uses it to call the secured HelloWorld endpoint, verifies the missing-token challenge, and reads the public JWKS.",
      "item": [
        {
          "name": "Issue token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is a non-cacheable JSON token response\", function () {",
                  "    pm.response.to.be.json;",
                  "    pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\");",
                  "    pm.expect(pm.response.headers.get(\"Pragma\")).to.include(\"no-cache\");",
                  "",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.access_token).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(response.token_type).to.eql(\"Bearer\");",
                  "    pm.expect(response.expires_in).to.be.a(\"number\").and.above(0);",
                  "    pm.environment.set(\"accessToken\", response.access_token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded",
                "type": "text"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "subject",
                  "value": "{{subject}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{authorizationServerUrl}}/api/v1/tokens",
              "host": [
                "{{authorizationServerUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tokens"
              ]
            },
            "description": "Sends the subject only in the form body and stores the returned access token in the local environment."
          },
          "response": []
        },
        {
          "name": "Call HelloWorld",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Greeting belongs to the authenticated subject\", function () {",
                  "    pm.response.to.be.json;",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.message).to.eql(`Hello, ${pm.environment.get(\"subject\")}!`);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{resourceServerUrl}}/api/v1/hello",
              "host": [
                "{{resourceServerUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "hello"
              ]
            },
            "description": "Calls the secured endpoint with Authorization: Bearer {{accessToken}}."
          },
          "response": []
        },
        {
          "name": "Call HelloWorld without token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Missing bearer token is rejected with an RFC 6750 challenge\", function () {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.headers.get(\"WWW-Authenticate\")).to.eql(\"Bearer\");",
                  "    pm.expect(pm.response.text()).to.eql(\"\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{resourceServerUrl}}/api/v1/hello",
              "host": [
                "{{resourceServerUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "hello"
              ]
            },
            "description": "Confirms that the controller cannot be reached without bearer authentication."
          },
          "response": []
        },
        {
          "name": "Read JWKS",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"JWKS contains usable RSA public keys only\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/jwk-set+json\");",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.keys).to.be.an(\"array\").that.is.not.empty;",
                  "",
                  "    const privateMembers = [\"d\", \"p\", \"q\", \"dp\", \"dq\", \"qi\", \"oth\"];",
                  "    response.keys.forEach(function (key) {",
                  "        pm.expect(key.kty).to.eql(\"RSA\");",
                  "        pm.expect(key.use).to.eql(\"sig\");",
                  "        pm.expect(key.alg).to.eql(\"RS256\");",
                  "        pm.expect(key.kid).to.be.a(\"string\").and.not.empty;",
                  "        pm.expect(key.n).to.be.a(\"string\").and.not.empty;",
                  "        pm.expect(key.e).to.be.a(\"string\").and.not.empty;",
                  "        privateMembers.forEach(function (member) {",
                  "            pm.expect(key).not.to.have.property(member);",
                  "        });",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/jwk-set+json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{authorizationServerUrl}}/oauth2/jwks",
              "host": [
                "{{authorizationServerUrl}}"
              ],
              "path": [
                "oauth2",
                "jwks"
              ]
            },
            "description": "Reads the public signing keys and verifies that no private RSA parameters are exposed."
          },
          "response": []
        }
      ]
    }
  ]
}
